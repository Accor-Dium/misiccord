<?xml version="1.0" encoding="utf-8"?>
<!-- Widget de Misiccord (WidgetMisiccord.kt): portada, canción y controles. Tocarlo abre la app. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_fondo"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="10dp">

    <ImageView
        android:id="@+id/widget_portada"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:background="@drawable/widget_portada_fondo"
        android:clipToOutline="true"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@mipmap/ic_launcher" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_titulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/app_name"
            android:textColor="#FFFFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_artista"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_abrir"
            android:textColor="#B3FFFFFF"
            android:textSize="13sp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/widget_anterior"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/widget_boton"
        android:contentDescription="@string/widget_anterior"
        android:src="@drawable/widget_anterior" />

    <ImageButton
        android:id="@+id/widget_play"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginHorizontal="4dp"
        android:background="@drawable/widget_boton_play"
        android:contentDescription="@string/widget_reproducir"
        android:src="@drawable/widget_play" />

    <ImageButton
        android:id="@+id/widget_siguiente"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/widget_boton"
        android:contentDescription="@string/widget_siguiente"
        android:src="@drawable/widget_siguiente" />
</LinearLayout>
