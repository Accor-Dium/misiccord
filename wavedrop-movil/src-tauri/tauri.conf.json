{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Misiccord",
  "mainBinaryName": "Misiccord",
  "version": "2.1.0",
  "identifier": "com.wavedrop.movil",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Misiccord",
        "width": 1360,
        "height": 880,
        "minWidth": 380,
        "minHeight": 600,
        "backgroundColor": "#0a0f14"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Misiccord",
    "shortDescription": "Descarga, escucha y comparte música en jams",
    "longDescription": "Misiccord: busca y descarga música de YouTube Music, Spotify y más; reproductor con letras sincronizadas, recomendaciones y jams en red local.",
    "resources": {
      "../servicio-dist/misiccord-servicio/": "servicio/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Spanish"
        ],
        "displayLanguageSelector": false
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhEMTI4MTQzRUEwRjBBNzUKUldSMUNnL3FRNEVTallieUk1RzRCdW05NE1RS3lXdWhIVEM0b3RZOHc1bGx6dmNpeldhK3l6WFIK",
      "endpoints": [
        "https://github.com/Accor-Dium/misiccord/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    },
    "deep-link": {
      "mobile": [
        {
          "scheme": [
            "misiccord"
          ],
          "appLink": false
        }
      ],
      "desktop": {
        "schemes": [
          "misiccord"
        ]
      }
    }
  }
}
