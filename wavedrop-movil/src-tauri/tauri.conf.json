{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WaveDrop",
  "version": "0.1.0",
  "identifier": "com.wavedrop.movil",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "WaveDrop",
        "width": 1360,
        "height": 880,
        "minWidth": 380,
        "minHeight": 600,
        "backgroundColor": "#0a0f14"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
